<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RiMCP</AssemblyName>
    <RootNamespace>RiMCP</RootNamespace>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="ValidateRimWorldManagedPath" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(RimWorldManagedPath)' == ''"
      Text="Set RimWorldManagedPath to RimWorld's Data/Managed directory, for example: dotnet build RiMCP/Source/RiMCP.csproj -p:RimWorldManagedPath=&quot;/path/to/RimWorld/Data/Managed&quot;" />
    <Error
      Condition="'$(RimWorldManagedPath)' != '' And !Exists('$(RimWorldManagedPath)/Assembly-CSharp.dll')"
      Text="RimWorldManagedPath does not contain Assembly-CSharp.dll: $(RimWorldManagedPath)" />
  </Target>

  <ItemGroup>
    <Compile Include="../../Shared/ToolManifest.cs" Link="Shared/ToolManifest.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
