#!/bin/sh
set -eu

script_dir=$(cd "$(dirname "$0")" && pwd)
os=$(uname -s)
arch=$(uname -m)

case "$os:$arch" in
  Darwin:arm64|Darwin:aarch64)
    rid="osx-arm64"
    ;;
  Darwin:x86_64|Darwin:amd64)
    rid="osx-x64"
    ;;
  Linux:x86_64|Linux:amd64)
    rid="linux-x64"
    ;;
  *)
    echo "Rim-MCP MCP proxy is not bundled for this platform: $os $arch" >&2
    exit 1
    ;;
esac

exe="$script_dir/$rid/RiMCP.McpProxy"
if [ ! -f "$exe" ]; then
  echo "Rim-MCP MCP proxy executable is missing: $exe" >&2
  echo "Reinstall the mod to restore the bundled helper." >&2
  exit 1
fi

if [ ! -x "$exe" ] && ! chmod u+x "$exe"; then
  echo "Rim-MCP could not make its bundled helper executable: $exe" >&2
  exit 1
fi

exec "$exe" "$@"
