#!/bin/sh
set -eu

script_dir=$(cd "$(dirname "$0")" && pwd)
os=$(uname -s)
arch=$(uname -m)

case "$os:$arch" in
  Darwin:arm64|Darwin:aarch64)
    rid="osx-arm64"
    ;;
  Darwin:x86_64|Darwin:amd64)
    rid="osx-x64"
    ;;
  Linux:x86_64|Linux:amd64)
    rid="linux-x64"
    ;;
  *)
    echo "RiMCP MCP proxy is not bundled for this platform: $os $arch" >&2
    exit 1
    ;;
esac

exe="$script_dir/$rid/RiMCP.McpProxy"
if [ ! -x "$exe" ]; then
  echo "RiMCP MCP proxy executable is missing or not executable: $exe" >&2
  echo "Build it with scripts/publish-mcp-proxy.sh before packaging the mod." >&2
  exit 1
fi

exec "$exe" "$@"
