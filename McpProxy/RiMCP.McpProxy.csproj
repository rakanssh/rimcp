<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RiMCP.McpProxy</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ToolManifest.cs" Link="Shared/ToolManifest.cs" />
  </ItemGroup>
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" DependsOnTargets="ResolveFrameworkReferences"
          Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE.TXT;%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT"
                      Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeNotice)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
